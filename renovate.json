{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":automergeMinor",
    ":prConcurrentLimit10",
    "workarounds:typesNodeVersioning",
    ":automergeDigest"
  ],
  "labels": ["dependencies"],
  "minimumReleaseAge": "3 days",
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"],
    "reviewers": ["brpaz"]
  },
  "osvVulnerabilityAlerts": true,
  "packageRules": [
    {
      "description": "One weekly PR for all non-major updates; automerges when CI is green",
      "matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest"],
      "groupName": "non-major dependencies"
    },
    {
      "description": "Majors need a human",
      "matchUpdateTypes": ["major"],
      "reviewers": ["brpaz"]
    },
    {
      "matchPackageNames": ["node", "@types/node"],
      "groupName": "node"
    },
    {
      "matchPackageNames": [
        "react",
        "react-dom",
        "@types/react",
        "@types/react-dom"
      ],
      "groupName": "react"
    }
  ],
  "schedule": ["before 6am on monday"]
}
